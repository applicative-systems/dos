# mkdocs-flake settings for the website (`nix build .#documentation`).
# The hand-written pages live in documentation/docs/; the generated ones are
# copied in before mkdocs runs:
#   requirements/  one page per requirement (packages.docs)
#   options.md     NixOS option reference (packages.modules-markdown)
#   status.md      docs/STATUS.md (packages.status)
# `nix run .#watch-documentation` serves documentation/ as is, i.e. without
# the generated pages.
{ self', pkgs }:
let
  repoBlob = "https://github.com/applicative-systems/dos/blob/main";

  # mkdocs-flake splices the hook into `eval "..."`, so it only calls this script.
  addGeneratedPages = pkgs.writeShellScript "add-generated-pages" ''
    set -euo pipefail
    # the mkdocs root is symlink-copied from the store: directories are read-only
    chmod -R u+w docs

    mkdir docs/requirements
    cp ${self'.packages.docs}/KONF.*.md docs/requirements/
    cp ${self'.packages.docs}/README.md docs/requirements/index.md
    # awesome-pages: natural order (KONF.7.9 before KONF.7.10)
    {
      echo "title: Requirements"
      echo "nav:"
      echo "  - index.md"
      (cd docs/requirements && ls KONF.*.md | sort -V | sed 's/^/  - /')
    } > docs/requirements/.pages

    {
      echo "# NixOS module options"
      echo
      echo "All options of the requirement modules (\`nixosModules.default\`). Generated by \`nixosOptionsDoc\`."
      echo
      cat ${self'.packages.modules-markdown}
    } > docs/options.md

    # STATUS.md links module and test files relative to docs/ in the repository
    sed 's|](\.\./|](${repoBlob}/|g' ${self'.packages.status} > docs/status.md
  '';
in
{
  mkdocs-root = ../documentation;
  strict = true;
  mkdocs-preBuildHook = "${addGeneratedPages}";
}
